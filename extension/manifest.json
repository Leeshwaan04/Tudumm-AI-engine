{
  "manifest_version": 3,
  "name": "Tudumm: Market Signals",
  "short_name": "Tudumm",
  "version": "0.2.0",
  "description": "Trade setups with defined risk on the charts you open. Prices labelled real-time or delayed. Not investment advice.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tudumm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://tudumm.in/*",
    "https://tudumm-ai-engine.sumitbagewadi6.workers.dev/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://tudumm.in https://tudumm-ai-engine.sumitbagewadi6.workers.dev https://data-api.binance.vision wss://data-stream.binance.vision http://localhost:* http://127.0.0.1:*"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://finance.yahoo.com/*",
        "https://www.google.com/finance/*",
        "https://kite.zerodha.com/*",
        "https://www.nseindia.com/*",
        "https://www.binance.com/*",
        "https://www.investing.com/*",
        "https://www.moneycontrol.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

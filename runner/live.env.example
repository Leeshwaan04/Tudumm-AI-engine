# Tudumm live feed config. Copy to runner/live.env (git-ignored), fill in, then: npm run live
# Keep runner/live.env private (chmod 600). These values give read access to your 5paisa account.

# Where to push. INGEST_TOKEN defaults to ~/.config/tudumm/ingest-token (written by scripts/set-secrets.sh).
TUDUMM_URL=https://tudumm.in
# INGEST_TOKEN=

# --- 5paisa Xstream (market DATA only; orders always go through Zerodha Kite) ---
# xstream.5paisa.com -> API keys: copy User Key, Encryption Key and User ID.
FIVEPAISA_APP_KEY=
FIVEPAISA_ENCRYPTION_KEY=
FIVEPAISA_USER_ID=
# Your 5paisa client code, your login PIN/MPIN, and the base32 TOTP secret 5paisa showed when you
# enabled TOTP (the text key behind the QR code, not a 6-digit code).
FIVEPAISA_CLIENT_CODE=
FIVEPAISA_PIN=
FIVEPAISA_TOTP_SECRET=
# Optional: pin scrip codes if name matching fails (printed at startup), e.g. NIFTY=999920000,BANKNIFTY=999920005
# FIVEPAISA_SCRIPS=
# Optional: the historical API's subscription key (defaults to the public one in 5paisa's py5paisa SDK; "none" disables)
# FIVEPAISA_SUBSCRIPTION_KEY=

# --- tuning (defaults shown). Each push is one Worker request + a few D1 rows; the Workers Free plan
# allows ~100k D1 rows written per day, which these defaults stay under. ---
# PUSH_MS_IN=5000          # India quote push interval during the NSE session
# PUSH_MS_CRYPTO=15000     # crypto quote push interval (24/7)
# CRYPTO_JOB_MS=300000     # crypto full refresh (bars, depth, funding/OI)
# LIVE_INDIA=on
# LIVE_CRYPTO=on

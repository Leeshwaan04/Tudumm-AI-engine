{
  // Tudumm prototype: static site (landing + terminal + hosted extension preview) on
  // Cloudflare Workers static assets, fronted by a tiny Worker (security headers, optional UAT gate).
  // Cloudflare Workers Builds runs `npx wrangler deploy`, which runs build.command first.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tudumm-ai-engine",
  "main": "deploy/worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bash scripts/build-site.sh"
  },
  "assets": {
    "directory": "deploy/.stage/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
